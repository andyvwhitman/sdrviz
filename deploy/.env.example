# Copy to deploy/.env and edit. The real .env is never committed.

# Host name Caddy serves. A public name gets a Let's Encrypt certificate; "localhost" uses Caddy's own CA.
SDRVIZ_DOMAIN=localhost

# Public address of the site. Node keys carry it, so set it before creating the first node.
SDRVIZ_PUBLIC_URL=https://localhost

# The viewer password: people with it can look and listen, not change anything. Share it. At least 8 characters
# (the server refuses to start on an https address with a default or short one); make it long and random.
SDRVIZ_PASSWORD=change-me

# The admin password: nodes, sources, banks, frequencies, settings. Keep it to yourself; it must differ from the
# viewer password. If left empty the viewer password is also the admin password (everyone who has it is admin).
SDRVIZ_ADMIN_PASSWORD=

# Signs the session cookie, at least 32 characters. Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SDRVIZ_SECRET=change-me-too

# false turns every simulated thing off (replayed radio, transcripts, fictional feeds and trains). Use false on a
# server; true shows the demo day on a laptop.
SDRVIZ_SIM=true

# Optional: a LAN rtl_tcp server (for example sdr.local). Leave empty to run on the simulation only.
SDRVIZ_RTLTCP_HOST=

# Recordings: every transmission on a banked channel is saved as audio and transcribed on the server CPU.
# faster-whisper, or none to save audio without transcripts. The speech model (about 500 MB) is downloaded on the
# first transcription and kept in the data volume. The thread count leaves the other cores to the web app.
SDRVIZ_TRANSCRIBER=faster-whisper
SDRVIZ_WHISPER_THREADS=2

# Audio is deleted after this many days, or oldest first once the audio store is bigger than this many GB. The
# transcripts and the list of transmissions are kept forever.
SDRVIZ_AUDIO_RETENTION_DAYS=90
SDRVIZ_AUDIO_MAX_GB=10

# Host ports. Keep 80 and 443 on a server; change them on a laptop where those are taken.
SDRVIZ_HTTP_PORT=80
SDRVIZ_HTTPS_PORT=443
