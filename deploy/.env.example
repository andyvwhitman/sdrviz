# Copy to deploy/.env and edit. The real .env is never committed.

# Host name Caddy serves. A public name gets a Let's Encrypt certificate; "localhost" uses Caddy's own CA.
SDRVIZ_DOMAIN=localhost

# Public address of the site. Node keys carry it, so set it before creating the first node.
SDRVIZ_PUBLIC_URL=https://localhost

# The one shared viewer password. Make it long and random on a server.
SDRVIZ_PASSWORD=change-me

# Signs the session cookie. Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SDRVIZ_SECRET=change-me-too

# Optional: a LAN rtl_tcp server (for example sdr.local). Leave empty to run on the simulation only.
SDRVIZ_RTLTCP_HOST=

# Host ports. Keep 80 and 443 on a server; change them on a laptop where those are taken.
SDRVIZ_HTTP_PORT=80
SDRVIZ_HTTPS_PORT=443
