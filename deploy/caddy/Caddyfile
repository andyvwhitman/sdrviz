# SDRVIZ_DOMAIN is a host name (automatic Let's Encrypt TLS) or "localhost" (Caddy's internal CA).
{$SDRVIZ_DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
	}

	# Caddy proxies WebSocket upgrades without extra configuration.
	handle /api/* {
		reverse_proxy api:8100
	}
	handle /ws/* {
		reverse_proxy api:8100
	}

	# Everything else is the app. Vite hashes files under /assets, so those cache for good.
	handle {
		root * /srv/www
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
