# sdrviz rtl_tcp settings. Installed to /etc/sdrviz/rtltcp.env.
# Edit, then apply with:  sudo systemctl restart sdrviz-rtltcp

# Address and port rtl_tcp listens on. 0.0.0.0 = every interface on the Pi.
# rtl_tcp has no authentication, so keep it on your LAN (don't port-forward it).
RTLTCP_ADDRESS=0.0.0.0
RTLTCP_PORT=1234

# Center frequency in Hz. 160.8975 MHz sits between AAR channels 52 and 53, which keeps
# the RTL-SDR's DC spike off a real channel. At 2.4 MS/s the stream covers about
# 159.9-161.9 MHz usable, which is every AAR road channel (07-97, 160.215-161.565 MHz).
RTLTCP_FREQ=160897500

# Sample rate in samples/second. 2.4 MS/s is the highest rate that's reliable on RTL-SDR.
# The network load is about 38 Mbit/s, so use wired Ethernet if you can.
RTLTCP_RATE=2400000

# Tuner gain in dB; 0 = automatic. Start around 30-40 and adjust (see README).
RTLTCP_GAIN=36.4

# Frequency correction in ppm. Most TCXO dongles (e.g. RTL-SDR Blog V3/V4) need 0.
RTLTCP_PPM=0

# Device index, if more than one dongle is plugged in (0 = first).
RTLTCP_DEVICE=0
